# Caddy local TLS state (auto-managed by `tls internal`)
caddy/data/
caddy/config/

# Docker secrets: file-backed credential material (see secrets/README.md).
# Only the README is tracked; every value file stays local.
secrets/*
!secrets/README.md

# Local environment and build artifacts
.env.local
.env.*.local
.env
docker-compose.override.yml
frontend/node_modules/
node_modules/
frontend/.next/
backend/__pycache__/
backend/**/*.pyc
frontend/coverage/
frontend/test-results/
frontend/playwright-report/
/.claude

# OMC state, session scratch, and stale build dirs
.omc/
frontend/.next.root-old/
progress.txt

# KB pipeline outputs/cache from host-side runs (Docker uses the kb_data volume)
backend/data/kb/

# KB debug artifacts dropped at the repo root by host-side runs
/extraction.json
/windows_view.html
