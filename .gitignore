# SSL/TLS Certificates and Keys
nginx/certs/*.key
nginx/certs/*.pem

# Self-signed certificates (optional - uncomment if you don't want to track these either)
# nginx/certs/*.crt

# Local environment and build artifacts
.env.local
.env.*.local
frontend/node_modules/
frontend/.next/
backend/__pycache__/
backend/**/*.pyc
frontend/coverage/
frontend/test-results/
frontend/playwright-report/
