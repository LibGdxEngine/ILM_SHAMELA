# Non-secret configuration only.
#
# Every credential now lives in ./secrets/ as a file-backed Docker secret, not
# here. Create those files with `make secrets` (or `bash scripts/init-secrets.sh`)
# before the first `docker compose up` — see secrets/README.md.
#
# Moved out of this file: SECRET_KEY, POSTGRES_PASSWORD, MINIO_ROOT_PASSWORD,
# GOOGLE_CLIENT_SECRET, GEMINI_API_KEY, OPENROUTER_API_KEY, ANTHROPIC_API_KEY.

# Environment Mode: dev or prod
ENVIRONMENT=dev
DEBUG=true

# Required config (the matching password is secrets/postgres_password.txt)
POSTGRES_DB=search_db
POSTGRES_USER=search_user

# Optional
# Host port for direct backend access. Only affects http://localhost:<port>/ —
# Caddy and the frontend always use backend:8000 on the internal network.
# Override when something else already holds 8000 on your machine.
#BACKEND_HOST_PORT=8000
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://localhost:3000

# MinIO username; the password is secrets/minio_root_password.txt
MINIO_ROOT_USER=minioadmin

# Google OAuth. The client ID is public (it ships in the frontend bundle); the
# client secret is secrets/google_client_secret.txt.
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Gemini Embedding (required for semantic search reranking AND the assistant's
# RAG fallback on long documents). Wrapped via langchain-google-genai.
# Get key from: https://aistudio.google.com/app/apikey
#   -> paste into secrets/gemini_api_key.txt

# OpenRouter (chat model for the reader's المساعد الذكي tab)
# Get key from: https://openrouter.ai/keys
#   -> paste into secrets/openrouter_api_key.txt
# Default chat model. Any OpenRouter slug works; Flash Lite is cheap + fast.
OPENROUTER_CHAT_MODEL=google/gemini-2.5-flash-lite
# Library-assistant / layer0-classifier model (also recorded in
# DocumentMeta.model_id for the extraction audit trail).
OPENROUTER_AGENT_MODEL=google/gemini-3.1-flash-lite
# LEGACY NER model (deprecated first-25-page pass; kept only for
# `backfill_extractions --extractor ner`). Uploads now run the KB pipeline
# below instead.
OPENROUTER_NER_MODEL=google/gemini-2.5-flash
# Sent as HTTP-Referer for OpenRouter attribution analytics.
OPENROUTER_REFERER=https://ilm-shamela.local

# --- KB extraction pipeline (extraction/kb/) --------------------------------
# Whole-book segmentation + two-pass NER/KB extraction, run automatically on
# every upload. Stage 1 (split) bills cents per book on OpenRouter; Stage 2
# (extraction) bills DOLLARS per book on Gemini (direct Google API — needs
# secrets/gemini_api_key.txt). Every LLM answer is disk-cached, so re-runs
# only bill new work. `manage.py run_kb_pipeline --dry-run` estimates first.
# KB_SPLIT_MODEL is an OpenRouter slug; KB_EXTRACT_MODEL is a *Google* model
# id (AI Studio / Vertex via google-genai), NOT an OpenRouter slug.
KB_SPLIT_MODEL=deepseek/deepseek-v4-flash
KB_EXTRACT_MODEL=gemini-3.1-pro-preview
# Gemini thinking level for extraction calls: low | medium | high
KB_THINKING_LEVEL=medium
# Auto-run tripwires (upload-triggered runs only; the management command
# bypasses them). A guarded skip is recorded on the ExtractionRun row.
KB_AUTO_ENABLED=true
KB_MAX_AUTO_COST_USD=15
KB_MAX_DOC_CHARS=4000000

# Deprecated: kept for fallback / older code paths. Safe to leave the secret
# file (secrets/anthropic_api_key.txt) empty if you've fully migrated to
# OpenRouter.
ANTHROPIC_CHAT_MODEL=claude-sonnet-4-6

FRONTEND_DOCKERFILE=Dockerfile.dev

# URL the Next.js dev server proxies /api and /media requests to.
# Default targets the Docker service hostname, which works when the frontend
# runs inside docker-compose. If you run the frontend on the HOST instead
# (npm run dev), 'backend' won't resolve — set this to http://localhost:8000
# (e.g. in frontend/.env.local) or /api/* requests 500 at the proxy layer.
BACKEND_PROXY_URL=http://backend:8000

DOCLING_OCR_ENABLED=true
# Docling uses EasyOCR — ISO 639-1 codes (ar, en, fa, ur), not Tesseract's 3-letter codes.
DOCLING_OCR_LANG=ar,en,fa,ur
# Table-structure model: "fast" (~half the RAM, default) or "accurate".
DOCLING_TABLE_MODE=fast
# Hard memory cap on the docling container; raise on hosts with more RAM.
DOCLING_MEM_LIMIT=3g
# Thread count for the docling model runtimes (BLAS/torch/OMP).
DOCLING_OMP_THREADS=2
