# Environment Mode: dev or prod
ENVIRONMENT=dev
DEBUG=true

# Required secrets/config
SECRET_KEY=replace-with-a-long-random-secret
POSTGRES_DB=search_db
POSTGRES_USER=search_user
POSTGRES_PASSWORD=search_password

# Optional
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://localhost:3000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Gemini Embedding (required for semantic search reranking AND the assistant's
# RAG fallback on long documents). Wrapped via langchain-google-genai.
# Get key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# OpenRouter (chat model for the reader's المساعد الذكي tab)
# Get key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Default chat model. Any OpenRouter slug works; Flash Lite is cheap + fast.
OPENROUTER_CHAT_MODEL=google/gemini-2.5-flash-lite
# Sent as HTTP-Referer for OpenRouter attribution analytics.
OPENROUTER_REFERER=https://ilm-shamela.local

# Deprecated: kept for fallback / older code paths. Safe to leave empty if
# you've fully migrated to OpenRouter.
ANTHROPIC_API_KEY=
ANTHROPIC_CHAT_MODEL=claude-sonnet-4-6

FRONTEND_DOCKERFILE=Dockerfile.dev

DOCLING_OCR_ENABLED=true
# Docling uses EasyOCR — ISO 639-1 codes (ar, en, fa, ur), not Tesseract's 3-letter codes.
DOCLING_OCR_LANG=ar,en,fa,ur
# Table-structure model: "fast" (~half the RAM, default) or "accurate".
DOCLING_TABLE_MODE=fast
# Hard memory cap on the docling container; raise on hosts with more RAM.
DOCLING_MEM_LIMIT=3g
# Thread count for the docling model runtimes (BLAS/torch/OMP).
DOCLING_OMP_THREADS=2