{
	# Disable automatic HTTP->HTTPS redirects (we define them explicitly below)
	auto_https disable_redirects
	# Pick a default SNI so requests that hit us by bare IP (no SNI sent)
	# still get a valid certificate served back.
	default_sni ilmshamela.com
}

(app) {
	encode zstd gzip

	request_body {
		max_size 100MB
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Frame-Options "SAMEORIGIN"
		X-Content-Type-Options "nosniff"
		X-XSS-Protection "1; mode=block"
	}

	# Django static files
	handle_path /static/* {
		root * /var/www/staticfiles
		file_server
		header Cache-Control "public, immutable, max-age=2592000"
	}

	# Django admin (match bare /admin AND /admin/* so the SPA catch-all never grabs it)
	@admin path /admin /admin/*
	handle @admin {
		reverse_proxy backend:8000
	}

	# Django media
	handle /media/* {
		header Cache-Control "public, immutable, max-age=604800"
		reverse_proxy backend:8000
	}

	# Django API
	handle /api/* {
		reverse_proxy backend:8000
	}

	# Everything else -> Next.js frontend
	handle {
		reverse_proxy frontend:3000
	}
}

# HTTP: redirect to HTTPS
:80 {
	redir https://{host}{uri} permanent
}

# Redirect www -> apex
https://www.ilmshamela.com {
	redir https://ilmshamela.com{uri} permanent
}

# Public domain — Let's Encrypt cert issued automatically
https://ilmshamela.com {
	import app
}

# Bare-IP / localhost entry uses Caddy's internal CA (self-signed).
# Lets you reach the server directly by IP for debugging.
https://2.24.9.126, https://localhost, https://127.0.0.1 {
	tls internal
	import app
}
